# Environment Configuration
ENVIRONMENT=development

# Database
DATABASE_URL=sqlite:///./data/geocoder.db

# Logging
LOG_LEVEL=DEBUG

# External Geocoder (optional)
NOMINATIM_USER_AGENT=OpenIIT-Geocoder/1.0
GOOGLE_MAPS_API_KEY=

# ML Models
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
USE_CUDA=false

# API
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend
VITE_API_URL=http://localhost:8000
# Optional Google Maps JavaScript API key. Restrict it by HTTP referrer in Google Cloud.
VITE_GOOGLE_MAPS_API_KEY=